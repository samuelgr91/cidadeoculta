# Server-only values. Copy to .env.local for native Next.js development.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=replace-with-your-database-token
APP_ORIGIN=http://localhost:3000
PAYMENT_MODE=demo
PUBLIC_INDEXING_ENABLED=false
PAYMENT_PROVIDER=kiwify
ADMIN_EMAILS=
MAP_DEFAULT_VIEW=editorial
EBOOK_KIWIFY_PRODUCT_ID=ac1905e0-bc2c-11f1-8789-a3baa1622882
EBOOK_KIWIFY_CHECKOUT_URL=https://pay.kiwify.com.br/1hCCgo6
EBOOK_PRICE_CENTS=2990
AUTH_HASH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
PASS_TRANSFER_SECRET=use-the-same-random-secret-on-the-original-Site-and-Vercel
RESEND_API_KEY=replace-with-your-resend-api-key
AUTH_FROM_EMAIL=Cidade Oculta <acesso@your-verified-domain.com>

# For a live, one-time City Pass on native Next.js/Vercel only:
# PAYMENT_MODE=live
# APP_ORIGIN=https://hiddenatlas.site
# KIWIFY_PRODUCTS_JSON={"ouro-preto":{"productId":"7b4fe5e0-b9bc-11f1-8e3c-f7e840e55886","checkoutUrl":"https://pay.kiwify.com.br/ZZN1K13"}}
# KIWIFY_WEBHOOK_TOKEN=replace-with-the-token-shown-by-your-Kiwify-webhook
# KIWIFY_EBOOK_WEBHOOK_TOKEN=replace-with-the-token-shown-by-your-ebook-webhook
# KIWIFY_STORE_ID=optional-store-id-for-extra-validation

# Legacy adapter, only if PAYMENT_PROVIDER=mercado_pago:
# MP_ACCESS_TOKEN=
# MP_WEBHOOK_SECRET=
